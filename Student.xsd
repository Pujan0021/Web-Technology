<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">


  <xs:element name="Students">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Student" >
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Name">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="firstName" type="xs:string"/>
                    <xs:element name="lastName" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element name="faculty" type="xs:string"/>

              <xs:element name="batch" type="xs:string"/>

              <xs:element name="contact">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="home" type="xs:string"/>
                    <xs:element name="mobile" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element name="address">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="temp" type="xs:string"/>
                    <xs:element name="perm" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>

            <xs:attribute name="id" type="xs:string" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>

      <xs:attribute name="college" type="xs:string"  fixed="Nepathya"/>
    </xs:complexType>
  </xs:element>

</xs:schema>